TEST_USERNAME=
TEST_PASSWORD=

APP_ENV=production

#ESRI API Configuration
ESRI_API_HOST=asrbd.instat.gov.al
ESRI_API_SCHEME=https
ESRI_API_PATH=/server/rest/services/SALSTAT/asrbd/FeatureServer/

#ESRI API FOR MUNICIPALITY CONFIGURATION
ESRI_MUNICIPALITY_HOST=services7.arcgis.com
ESRI_MUNICIPALITY_SCHEME=https
ESRI_MUNICIPALITY_PATH=/E9FE1JuiACmTPbPv/arcgis/rest/services/Municipality/FeatureServer

# Portal and Esri token (GIS token is obtained via API_URL /auth/gis/login)
PORTAL_URL=https://asrbd.instat.gov.al/portal
ESRI_TOKEN_URL=https://asrbd.instat.gov.al/portal/sharing/rest/generateToken

#API SOCKET ENDPOINT
API_SOCKET_URL=wss://api-asrbd.instat.gov.al:9443/qms/fieldwork/is-active

#API URL
API_URL=https://api-asrbd.instat.gov.al:9443

# Basemap URLs
# Terrain (OpenStreetMap)
BASEMAP_TERRAIN_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Esri World Imagery
BASEMAP_ESRI_SATELLITE_URL=https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# ASIG Albania 2025 WMTS (EPSG:6870)
BASEMAP_ASIG_SATELLITE_2025_URL=https://di-albania-satellite1.img.arcgis.com/arcgis/rest/services/rgb/Albania_2025_L1/MapServer/WMTS/tile/1.0.0/rgb_Albania_2025_L1/default/default028mm/{z}/{y}/{x}

# MapServer export for snapshots
MAPSERVER_EXPORT_URL=https://asrbd.instat.gov.al/server/rest/services/SALSTAT/asrbd/MapServer/export

# Share building URL
SHARE_BASE_URL=https://web-asrbd.instat.gov.al:8443
